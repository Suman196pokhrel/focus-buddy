pkgname=focus-buddy
pkgver=0.3.0
pkgrel=1
pkgdesc='A local webcam focus reminder written in Rust'
url='https://github.com/Suman196pokhrel/focus-buddy'
arch=('x86_64' 'aarch64')
license=('MIT')
options=('!debug')
depends=('gtk4>=4.10' 'ffmpeg' 'onnxruntime>=1.22')
makedepends=('rust' 'cargo')
source=()
sha256sums=()
build() {
  cd "$startdir/.."
  cargo build --release --locked --offline -j 2
}
package() {
  cd "$startdir/.."
  install -Dm755 target/release/focus-buddy "$pkgdir/usr/bin/focus-buddy"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 packaging/focus-buddy.desktop "$pkgdir/usr/share/applications/focus-buddy.desktop"
  install -Dm644 assets/focus-buddy.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/focus-buddy.svg"
  for model in yunet landmarks; do
    install -Dm644 "models/$model.onnx" "$pkgdir/usr/share/focus-buddy/models/$model.onnx"
  done
  for notice in models/LICENSE-*; do
    install -Dm644 "$notice" "$pkgdir/usr/share/licenses/$pkgname/$(basename "$notice")"
  done
}
